MQTT_BROKER=ace2ba13.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8883
MQTT_USERNAME=mushroom-backend
MQTT_PASSWORD=your-mqtt-password
MQTT_CA_CERT=emqxsl-ca.crt
MQTT_TOPIC_PREFIX=mushroom-farm

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth
AUTH_SECRET_KEY=generate-with: openssl rand -hex 32
AUTH_USERNAME=admin
AUTH_PASSWORD=your-password-here
# AUTH_PASSWORD_HASH=  # bcrypt hash (use instead of plain AUTH_PASSWORD in production)
AUTH_TOKEN_EXPIRE_HOURS=24

# Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-public-key
